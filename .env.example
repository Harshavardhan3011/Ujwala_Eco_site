# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
# SERVER-ONLY: Required for admin image uploads (bypasses Storage RLS).
# Only ONE of the following needs to be set:
#   SUPABASE_SECRET_KEY     — new naming: Dashboard → Settings → API Keys → Secret key
#   SUPABASE_SERVICE_ROLE_KEY — legacy naming: Dashboard → Project Settings → API → service_role
# NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App Secrets
JWT_SECRET=
NEXT_PUBLIC_APP_URL=

# Business Order Email Configuration (Server-Only)
UJWALA_ORDER_EMAIL=ujwalaeco@gmail.com
RESEND_API_KEY=
RESEND_FROM=Ujwala Eco Products <ujwalaeco@gmail.com>

# Optional Payment Gateway (isolated, not required for order requests)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-Only Admin Bootstrap Variables (DO NOT expose as NEXT_PUBLIC_*)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_BOOTSTRAP_SECRET=
